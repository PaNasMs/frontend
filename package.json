{
  "name": "ostojaos-frontend",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "generate:api": "openapi-typescript ../backend/api/openapi.yaml -o src/api/schema.d.ts",
    "test:smoke": "node tests/smoke.mjs",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test:unit": "node --test tests/*.test.mjs",
    "build:modules": "tsc -p tsconfig.modules.json && OSTOJAOS_MODULE=files vite build --config module.vite.config.ts && OSTOJAOS_MODULE=terminal vite build --config module.vite.config.ts && OSTOJAOS_MODULE=cloud-sync vite build --config module.vite.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@mdi/js": "^7.4.47",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "^5.103.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.5.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
